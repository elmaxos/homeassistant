#!/bin/sh
# Rauschen (weiss/rosa/braun) in Endlosschleife ueber den Kamera-Lautsprecher (Thingino / prudynt).
# Laeuft komplett auf der Kamera; HA steuert per MQTT (<hostname>/cmd, eval):
#   noise start [vol]   noise stop   noise volume 0-80   noise color weiss|rosa|braun
#   noise fade_in 0-30   noise fade_out 0-30   noise boot   noise status
#
# - Wiedergabe: 60 s Material in 2-s-Stuecken ohne prudynt-Wiederholung, das Skript haengt immer ein Stueck an.
# - Lautstaerke = Lautsprecher-Lautstaerke audio.spk_vol, live per prudyntctl (ohne restart_thread -> sonst Aussetzer),
#   in 10er-Schritten, max. 80. Jede Aenderung wird weich uebergeblendet (FADE_VOL s).
# - Start blendet ein (FADE_IN s), Stopp/Farbwechsel blenden aus (FADE_OUT s), dann prudynt-Neustart: nur der leert
#   prudynts Audio-Warteschlange zuverlaessig (STOP/Ersetzen/restart_thread tun es bei langen Wiedergaben nicht).
#   Der Neustart laedt die gespeicherte Ansage-Lautstaerke aus /etc/prudynt.json; das Bild ist ~5-10 s weg.
# - "start" bei laufendem Rauschen startet nichts neu, sondern passt nur die Lautstaerke an.
# - Keine eigene Sperre: der MQTT-Dispatcher fuehrt Befehle nacheinander aus (eine mkdir-Sperre mit EXIT-trap
#   wurde unter dem Dispatcher nicht freigegeben -> jeder Befehl wartete 40 s).
# - weiss erzeugt die Kamera aus /dev/urandom (halbe Amplitude); rosa/braun einmalig von HA
#   (http://<broker>:8123/local/noise/<farbe>.pcm), Fallback weiss. Alles in /tmp (Flash zu klein).
# - Mit eingeschaltetem Mikrofon (AAC-Encoder) hat die Wiedergabe auf dem T23N Aussetzer -> Mikrofon aus.

HOST=$(hostname)
CONF=/etc/noise.conf
PIDF=/run/noise.pid
FADEP=/run/noise.fade.pid
PREVF=/run/noise.prev_spk_vol
DIR=/tmp/noise
RATE=16000
SECS=60
CH=2
NCH=$((SECS / CH))
BYTES=$((SECS * RATE * 2))
CHB=$((CH * RATE * 2))
VMAX=80
FADE_VOL=1.5

VOL=40
COLOR=braun
FADE_IN=5
FADE_OUT=5
[ -f "$CONF" ] && . "$CONF"

cfg() { jct /etc/thingino.json get "mqtt_sub.$1" 2>/dev/null | tr -d '"'; }
pub() {
	mosquitto_pub -h "$(cfg host)" -p "$(cfg port)" -u "$(cfg username)" -P "$(cfg password)" \
		-r -t "$HOST/state/$1" -m "$2" >/dev/null 2>&1
}
save() { printf 'VOL=%s\nCOLOR=%s\nFADE_IN=%s\nFADE_OUT=%s\n' "$VOL" "$COLOR" "$FADE_IN" "$FADE_OUT" > "$CONF"; }
running() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }
spk_get() { echo '{"audio":{"spk_vol":null}}' | prudyntctl json - 2>/dev/null | sed -n 's/.*"spk_vol":\([0-9]*\).*/\1/p'; }
spk_set() { printf '{"audio":{"spk_vol":%s}}' "$1" | prudyntctl json - >/dev/null 2>&1; }
pcm() { play $1 -f pcm -r "$RATE" "$2" >/dev/null 2>&1; }
norm_vol() { v=$(( ($1 + 5) / 10 * 10 )); [ "$v" -gt $VMAX ] && v=$VMAX; [ "$v" -lt 0 ] && v=0; echo "$v"; }

fade_kill() { [ -f "$FADEP" ] && kill "$(cat "$FADEP")" 2>/dev/null; rm -f "$FADEP"; }

# Lautstaerke von jetzt auf $2 in $1 Sekunden (0,25-s-Schritte); Ziel wird bei "einblenden" laufend aus CONF gelesen
ramp() {
	secs=$1; target=$2; follow=$3
	from=$(spk_get); from=${from:-0}
	steps=$(awk "BEGIN{print int($secs * 4 + 0.5)}"); [ "$steps" -lt 1 ] && steps=1
	i=1
	while [ $i -le $steps ]; do
		[ -n "$follow" ] && { t=$(sed -n 's/^VOL=//p' "$CONF"); target=${t:-$target}; }
		spk_set $((from + (target - from) * i / steps)); sleep 0.25; i=$((i + 1))
	done
	spk_set "$target"
}
ramp_bg() { fade_kill; ( ramp "$@" ) </dev/null >/dev/null 2>&1 & echo $! > "$FADEP"; }

prepare() {
	c=$1; f="$DIR/$c.pcm"
	[ -f "$f" ] && [ -f "$DIR/${c}_$((NCH - 1)).pcm" ] && { echo "$f"; return 0; }
	mkdir -p "$DIR"
	case "$c" in
		rosa|braun)
			curl -s -f -m 30 -o "$f.tmp" "http://$(cfg host):8123/local/noise/$c.pcm" \
				&& [ "$(wc -c < "$f.tmp")" -ge "$BYTES" ] || { rm -f "$f.tmp"; return 1; } ;;
		*)	# halbe Amplitude: jedes Byte nur 0..63 / 192..255 (etwa so laut wie rosa/braun, weniger scharf)
			set2=""; i=0
			while [ $i -lt 256 ]; do
				j=$(( i % 128 )); [ $j -ge 64 ] && j=$(( j + 128 ))
				set2="$set2\\$(printf %03o $j)"; i=$((i + 1))
			done
			head -c "$BYTES" /dev/urandom | tr '\000-\377' "$set2" > "$f.tmp" ;;
	esac
	mv "$f.tmp" "$f"
	i=0
	while [ $i -lt $NCH ]; do
		dd if="$f" of="$DIR/${c}_$i.pcm" bs=$CHB skip=$i count=1 2>/dev/null; i=$((i + 1))
	done
	echo "$f"
}

loop() {
	pre=${1%.pcm}
	t0=$(date +%s)
	pcm -A "${pre}_0.pcm"
	n=1
	while :; do
		pcm -A "${pre}_$((n % NCH)).pcm"                  # Stueck n (startet bei t0 + n*CH)
		target=$((t0 + n * CH)); now=$(date +%s)
		[ "$target" -gt "$now" ] && sleep $((target - now))   # bis Stueck n laeuft -> 1 Stueck Vorrat
		n=$((n + 1))
	done
}

kill_loop() {
	if running; then
		p=$(cat "$PIDF")
		pkill -P "$p" 2>/dev/null                        # zuerst das wartende sleep
		kill "$p" 2>/dev/null
	fi
	rm -f "$PIDF"
}

restart_prudynt() {
	TZ=$(cat /etc/TZ 2>/dev/null) /etc/init.d/S31prudynt restart >/dev/null 2>&1   # mit Zeitzone, sonst blendet prudynt UTC ein
	i=0
	while [ $i -lt 30 ]; do
		[ -S /run/prudynt/prudynt.sock ] && pidof prudynt >/dev/null && [ -p /run/prudynt/audio_out ] && break
		sleep 1; i=$((i + 1))
	done
	sleep 2
}

# laufendes Rauschen sauber beenden: ausblenden (Schleife schiebt noch nach), Schleife weg, stumm, Warteschlange leeren
silence() {
	fade_kill
	[ "$FADE_OUT" -gt 0 ] && ramp "$FADE_OUT" 0
	kill_loop
	spk_set 0
	restart_prudynt
}

start_fresh() {
	[ -f "$PREVF" ] || spk_get > "$PREVF"              # Ansage-Lautstaerke merken
	f=$(prepare "$COLOR") || { f=$(prepare weiss) && COLOR=weiss; } || return 1
	spk_set 0
	( loop "$f" ) </dev/null >/dev/null 2>&1 &
	echo $! > "$PIDF"
	if [ "$FADE_IN" -gt 0 ]; then ramp_bg "$FADE_IN" "$VOL" follow; else spk_set "$VOL"; fi
	pub noise ON; pub noise_volume "$VOL"; pub noise_color "$COLOR"
}

case "$1" in
	start)
		case "$2" in ''|*[!0-9]*) ;; *) VOL=$(norm_vol "$2") ;; esac
		VOL=$(norm_vol "$VOL"); save
		if running; then ramp_bg "$FADE_VOL" "$VOL"; pub noise ON; pub noise_volume "$VOL"   # schon an: nur Lautstaerke
		else start_fresh; fi ;;
	stop)
		if running; then
			pub noise OFF; silence; rm -f "$PREVF"
		elif [ -f "$PREVF" ]; then                          # Schleife weg, Lautstaerke noch verstellt
			spk_set 0; restart_prudynt; rm -f "$PREVF"
		else
			echo STOP > /run/prudynt/audio_out             # kein Rauschen: normaler Stopp fuer andere Sounds
		fi
		pub noise OFF ;;
	volume)
		case "$2" in ''|*[!0-9]*) echo "noise volume 0-$VMAX" >&2; exit 1 ;; esac
		VOL=$(norm_vol "$2"); save; pub noise_volume "$VOL"
		running && ramp_bg "$FADE_VOL" "$VOL" ;;
	color)
		case "$2" in weiss|rosa|braun) ;; *) echo "noise color weiss|rosa|braun" >&2; exit 1 ;; esac
		[ "$2" = "$COLOR" ] && { pub noise_color "$COLOR"; exit 0; }
		COLOR=$2; save; pub noise_color "$COLOR"
		if running; then silence; start_fresh; fi ;;
	fade_in|fade_out)
		case "$2" in ''|*[!0-9]*) echo "noise $1 0-30" >&2; exit 1 ;; esac
		v=$2; [ "$v" -gt 30 ] && v=30
		if [ "$1" = fade_in ]; then FADE_IN=$v; else FADE_OUT=$v; fi
		save; pub "noise_$1" "$v" ;;
	boot)
		rm -rf "$PIDF" "$PREVF" "$FADEP" /run/noise.lock
		VOL=$(norm_vol "$VOL"); save
		pub noise OFF; pub noise_volume "$VOL"; pub noise_color "$COLOR"
		pub noise_fade_in "$FADE_IN"; pub noise_fade_out "$FADE_OUT" ;;
	status)
		running && s=an || s=aus
		echo "$s, Lautstaerke $VOL, Farbe $COLOR, Ein/Aus $FADE_IN/$FADE_OUT s, Lautsprecher jetzt $(spk_get)" ;;
	*)
		echo "Usage: noise start [vol]|stop|volume N|color weiss|rosa|braun|fade_in S|fade_out S|boot|status" >&2; exit 1 ;;
esac

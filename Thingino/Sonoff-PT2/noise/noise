#!/bin/sh
# Rauschen (weiss/rosa/braun) in Endlosschleife ueber den Kamera-Lautsprecher (Thingino / prudynt).
# Laeuft komplett auf der Kamera; HA startet/stoppt nur per MQTT (<hostname>/cmd, eval):
#   noise start [lautstaerke]   noise stop   noise volume 0-100   noise color weiss|rosa|braun
#   noise fade_in 0-30   noise fade_out 0-30   (Sekunden Ein-/Ausblenden)
#   noise boot   noise status
#
# Wiedergabe: 60 s Material in 2-s-Stuecken, ohne prudynt-Wiederholung (loop=); das Skript haengt die Stuecke selbst
# an (1 Stueck Vorrat) -> gleichmaessig, ohne Delle. STOP / "Ersetzen" raeumen prudynts Audio-Warteschlange nicht
# zuverlaessig auf (getestet: STOP an audio_out und audio_out_ctrl, Audio-Thread-Neustart, kurze Stuecke, loop=).
# Deshalb Stopp/Farbwechsel: sofort stumm (spk_vol 0), dann prudynt-Neustart (Bild ~10 s weg); der Neustart laedt
# die gespeicherte Ansage-Lautstaerke aus /etc/prudynt.json.
# Lautstaerke = Lautsprecher-Lautstaerke (audio.spk_vol, live, OHNE Audio-Thread-Neustart - der bringt Aussetzer);
# beim Stopp wird die vorherige (Ansage-)Lautstaerke wiederhergestellt.
# weiss erzeugt die Kamera aus /dev/urandom (halbe Amplitude); rosa/braun kommen einmalig von HA
# (http://<broker>:8123/local/noise/<farbe>.pcm), Fallback weiss. Alles liegt in /tmp (Flash zu klein).
# Hinweis: Mit eingeschaltetem Mikrofon (AAC-Encoder) hat die Wiedergabe auf dem T23N Aussetzer.

HOST=$(hostname)
CONF=/etc/noise.conf
PIDF=/run/noise.pid
PREVF=/run/noise.prev_spk_vol
DIR=/tmp/noise
RATE=16000
SECS=60
BYTES=$((SECS * RATE * 2))
CH=2                              # Sekunden pro Stueck
NCH=$((SECS / CH))
CHB=$((CH * RATE * 2))

VOL=35
COLOR=braun
FADE_IN=5
FADE_OUT=5
[ -f "$CONF" ] && . "$CONF"

cfg() { jct /etc/thingino.json get "mqtt_sub.$1" 2>/dev/null | tr -d '"'; }
pub() {
	mosquitto_pub -h "$(cfg host)" -p "$(cfg port)" -u "$(cfg username)" -P "$(cfg password)" \
		-r -t "$HOST/state/$1" -m "$2" >/dev/null 2>&1
}
save() { printf 'VOL=%s\nCOLOR=%s\nFADE_IN=%s\nFADE_OUT=%s\n' "$VOL" "$COLOR" "$FADE_IN" "$FADE_OUT" > "$CONF"; }
FADEP=/run/noise.fade.pid
fade_kill() { [ -f "$FADEP" ] && kill "$(cat "$FADEP")" 2>/dev/null; rm -f "$FADEP"; }

# Einblenden 0 -> Ziel in 0,25-s-Schritten; das Ziel wird jeden Schritt neu aus der Konfiguration gelesen,
# damit eine Lautstaerke-Aenderung waehrend des Einblendens gilt
fade_in() {
	steps=$((FADE_IN * 4)); i=1
	while [ $i -le $steps ]; do
		v=$(sed -n 's/^VOL=//p' "$CONF"); v=${v:-$VOL}
		spk_set $((v * i / steps)); sleep 0.25; i=$((i + 1))
	done
	v=$(sed -n 's/^VOL=//p' "$CONF"); spk_set "${v:-$VOL}"
	rm -f "$FADEP"
}

# Ausblenden von der aktuellen Lautstaerke auf 0 (blockiert FADE_OUT Sekunden)
fade_out() {
	fade_kill
	from=$(spk_get); from=${from:-$VOL}; steps=$((FADE_OUT * 4)); i=1
	while [ $i -le $steps ]; do
		spk_set $((from - from * i / steps)); sleep 0.25; i=$((i + 1))
	done
}
running() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }
spk_get() { echo '{"audio":{"spk_vol":null}}' | prudyntctl json - 2>/dev/null | sed -n 's/.*"spk_vol":\([0-9]*\).*/\1/p'; }
spk_set() { printf '{"audio":{"spk_vol":%s}}' "$1" | prudyntctl json - >/dev/null 2>&1; }
pcm() { play $1 -f pcm -r "$RATE" "$2" >/dev/null 2>&1; }

# legt $DIR/<farbe>.pcm an (60 s), gibt den Pfad aus
prepare() {
	c=$1; f="$DIR/$c.pcm"
	[ -f "$f" ] && [ -f "$DIR/${c}_$((NCH - 1)).pcm" ] && { echo "$f"; return 0; }
	mkdir -p "$DIR"
	case "$c" in
		rosa|braun)
			curl -s -f -m 30 -o "$f.tmp" "http://$(cfg host):8123/local/noise/$c.pcm" \
				&& [ "$(wc -c < "$f.tmp")" -ge "$BYTES" ] || { rm -f "$f.tmp"; return 1; } ;;
		*)	# halbe Amplitude: jedes Byte nur 0..63 / 192..255 (etwa so laut wie rosa/braun, weniger scharf)
			set2=""; i=0
			while [ $i -lt 256 ]; do
				j=$(( i % 128 )); [ $j -ge 64 ] && j=$(( j + 128 ))
				set2="$set2\\$(printf %03o $j)"; i=$((i + 1))
			done
			head -c "$BYTES" /dev/urandom | tr '\000-\377' "$set2" > "$f.tmp" ;;
	esac
	mv "$f.tmp" "$f"
	i=0
	while [ $i -lt $NCH ]; do
		dd if="$f" of="$DIR/${c}_$i.pcm" bs=$CHB skip=$i count=1 2>/dev/null; i=$((i + 1))
	done
	echo "$f"
}

loop() {
	pre=${1%.pcm}
	t0=$(date +%s)
	pcm -A "${pre}_0.pcm"             # Stueck 0 (Warteschlange wurde vorher per STOP geleert)
	n=1
	while :; do
		pcm -A "${pre}_$((n % NCH)).pcm"   # Stueck n (startet bei t0 + n*CH)
		target=$((t0 + n * CH)); now=$(date +%s)
		[ "$target" -gt "$now" ] && sleep $((target - now))   # bis Stueck n laeuft -> 1 Stueck Vorrat
		n=$((n + 1))
	done
}

kill_loop() {
	if running; then
		p=$(cat "$PIDF")
		pkill -P "$p" 2>/dev/null     # zuerst das wartende sleep, sonst haengt es an init
		kill "$p" 2>/dev/null
	fi
	rm -f "$PIDF"
}

# prudynt neu starten und warten, bis es wieder laeuft (sonst geht ein direkt folgendes "start" ins Leere)
restart_prudynt() {
	/etc/init.d/S31prudynt restart >/dev/null 2>&1
	i=0
	while [ $i -lt 30 ]; do
		[ -S /run/prudynt/prudynt.sock ] && pidof prudynt >/dev/null && [ -p /run/prudynt/audio_out ] && break
		sleep 1; i=$((i + 1))
	done
	sleep 2
}

# laufendes Rauschen sicher beenden: sofort stumm, dann Warteschlange per prudynt-Neustart leeren
quiet_flush() {
	spk_set 0
	restart_prudynt
}

start() {
	if running; then
		fade_out; kill_loop; quiet_flush   # ausblenden, solange noch nachgeschoben wird; dann Warteschlange leeren
	else
		[ -f "$PREVF" ] || spk_get > "$PREVF"   # Ansage-Lautstaerke merken
		echo STOP > /run/prudynt/audio_out
	fi
	f=$(prepare "$COLOR") || { f=$(prepare weiss) && COLOR=weiss; } || exit 1
	spk_set 0
	loop "$f" </dev/null >/dev/null 2>&1 &
	echo $! > "$PIDF"
	if [ "$FADE_IN" -gt 0 ]; then
		fade_in </dev/null >/dev/null 2>&1 &
		echo $! > "$FADEP"
	else
		spk_set "$VOL"
	fi
	pub noise ON; pub noise_volume "$VOL"; pub noise_color "$COLOR"
}

stop() {
	if running; then
		pub noise OFF
		fade_out                          # ausblenden, waehrend die Schleife noch Stuecke nachschiebt
		kill_loop
		quiet_flush                       # Warteschlange leeren, laedt die gespeicherte Ansage-Lautstaerke
		rm -f "$PREVF"
	elif [ -f "$PREVF" ]; then            # Schleife weg, Lautstaerke noch verstellt -> aufraeumen
		quiet_flush; rm -f "$PREVF"
	else
		echo STOP > /run/prudynt/audio_out   # kein Rauschen: normaler Stopp fuer andere Sounds
	fi
	pub noise OFF
}

case "$1" in
	start)
		case "$2" in ''|*[!0-9]*) ;; *) VOL=$2 ;; esac
		save; start ;;
	stop)
		stop ;;
	volume)
		case "$2" in ''|*[!0-9]*) echo "noise volume 0-100" >&2; exit 1 ;; esac
		VOL=$2; [ "$VOL" -gt 100 ] && VOL=100
		save; pub noise_volume "$VOL"
		running && { [ -f "$FADEP" ] && kill -0 "$(cat "$FADEP")" 2>/dev/null || spk_set "$VOL"; } ;;
	color)
		case "$2" in weiss|rosa|braun) COLOR=$2 ;; *) echo "noise color weiss|rosa|braun" >&2; exit 1 ;; esac
		save; pub noise_color "$COLOR"
		running && start ;;
	fade_in|fade_out)
		case "$2" in ''|*[!0-9]*) echo "noise $1 0-30" >&2; exit 1 ;; esac
		v=$2; [ "$v" -gt 30 ] && v=30
		[ "$1" = fade_in ] && FADE_IN=$v || FADE_OUT=$v
		save; pub "noise_$1" "$v" ;;
	boot)
		rm -f "$PIDF" "$PREVF" "$FADEP"; pub noise OFF; pub noise_volume "$VOL"; pub noise_color "$COLOR"
		pub noise_fade_in "$FADE_IN"; pub noise_fade_out "$FADE_OUT" ;;
	status)
		running && s=an || s=aus; echo "$s, Lautstaerke $VOL, Farbe $COLOR, Ein/Aus $FADE_IN/$FADE_OUT s, Lautsprecher jetzt $(spk_get)" ;;
	*)
		echo "Usage: noise start [vol]|stop|volume N|color weiss|rosa|braun|fade_in S|fade_out S|boot|status" >&2; exit 1 ;;
esac
